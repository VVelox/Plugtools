# TOTP/MFA LDAP Schema
#
# This schema adds attributes and object classes for storing TOTP secrets
# and managing MFA enforcement policies in LDAP.
#
# Structure:
#   1.3.6.1.4.1.26481.2.8.1.x = Attribute Types
#   1.3.6.1.4.1.26481.2.8.2.x = Object Classes

# totpSecret - The TOTP shared secret (Base32 encoded)
attributetype ( 1.3.6.1.4.1.26481.2.8.1.1
  NAME 'totpSecret'
  DESC 'TOTP shared secret key (Base32 encoded, e.g., JBSWY3DPEHPK3PXP)'
  EQUALITY caseIgnoreMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
  SINGLE-VALUE )

# totpScratchCode - Backup/recovery codes (multi-valued)
attributetype ( 1.3.6.1.4.1.26481.2.8.1.2
  NAME 'totpScratchCode'
  DESC 'TOTP backup/scratch code for emergency access (8 digits)'
  EQUALITY caseIgnoreMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 )

# totpEnrolledDate - When the user enrolled in MFA
attributetype ( 1.3.6.1.4.1.26481.2.8.1.3
  NAME 'totpEnrolledDate'
  DESC 'Date and time when TOTP was enrolled (GeneralizedTime format)'
  EQUALITY generalizedTimeMatch
  ORDERING generalizedTimeOrderingMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.24
  SINGLE-VALUE )

# totpStatus - Current MFA enrollment status
attributetype ( 1.3.6.1.4.1.26481.2.8.1.4
  NAME 'totpStatus'
  DESC 'TOTP enrollment status: none, pending, active, disabled, bypassed'
  EQUALITY caseIgnoreMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
  SINGLE-VALUE )

# totpAlgorithm - HMAC algorithm used for TOTP
attributetype ( 1.3.6.1.4.1.26481.2.8.1.7
  NAME 'totpAlgorithm'
  DESC 'HMAC algorithm used for TOTP: SHA1, SHA256, or SHA512 (default SHA1)'
  EQUALITY caseIgnoreMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
  SINGLE-VALUE )

# totpPeriod - Time step in seconds (default 30)
attributetype ( 1.3.6.1.4.1.26481.2.8.1.8
  NAME 'totpPeriod'
  DESC 'TOTP time step in seconds (default 30)'
  EQUALITY integerMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.27
  SINGLE-VALUE )

# totpDigits - Number of OTP digits (default 6)
attributetype ( 1.3.6.1.4.1.26481.2.8.1.9
  NAME 'totpDigits'
  DESC 'Number of digits in the TOTP code: 6 or 8 (default 6)'
  EQUALITY integerMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.27
  SINGLE-VALUE )

# mfaRequired - Boolean flag for group-level MFA requirement
attributetype ( 1.3.6.1.4.1.26481.2.8.1.5
  NAME 'mfaRequired'
  DESC 'Boolean flag indicating MFA is required for this group'
  EQUALITY booleanMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.7
  SINGLE-VALUE )

# mfaGracePeriodDays - Grace period before MFA is enforced
attributetype ( 1.3.6.1.4.1.26481.2.8.1.6
  NAME 'mfaGracePeriodDays'
  DESC 'Number of days users have to set up MFA after account creation'
  EQUALITY integerMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.27
  SINGLE-VALUE )

# totpUser - Auxiliary class for users with TOTP/MFA
objectclass ( 1.3.6.1.4.1.26481.2.8.2.1
  NAME 'totpUser'
  DESC 'User with TOTP/MFA authentication capability'
  SUP top
  AUXILIARY
  MAY ( totpSecret $ totpScratchCode $ totpEnrolledDate $ totpStatus $ totpAlgorithm $ totpPeriod $ totpDigits ) )

# mfaGroup - Auxiliary class for groups with MFA policies
objectclass ( 1.3.6.1.4.1.26481.2.8.2.2
  NAME 'mfaGroup'
  DESC 'Group with MFA enforcement policy'
  SUP top
  AUXILIARY
  MAY ( mfaRequired $ mfaGracePeriodDays ) )
