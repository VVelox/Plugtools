% title 'Sign Out';

<div class="card border-secondary mt-4">
  <div class="card-header fw-bold">Sign Out</div>
  <div class="card-body text-center">
    <p class="mb-3">Do you want to sign out of Nisaba SSO?</p>

    <form method="post" action="<%= url_for('sso_logout_post') %>">
      <%= csrf_field %>
      <input type="hidden" name="post_logout_redirect_uri" value="<%= $post_logout_redirect_uri %>">
      <input type="hidden" name="state" value="<%= $state %>">
      <input type="hidden" name="client_id" value="<%= $client_id %>">
      <div class="d-flex gap-2 justify-content-center">
        <button type="submit" class="btn btn-danger">Sign Out</button>
      </div>
    </form>
  </div>
</div>
