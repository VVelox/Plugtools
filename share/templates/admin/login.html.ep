% layout 'default';
% title 'Admin Log In';
<div class="row justify-content-center mt-5">
  <div class="col-sm-10 col-md-6">
    %= include 'partials/login_card', heading => 'Admin Log In', submit_label => 'Log In', login_post_url => url_for('admin_login_post'), passkey_start_url => url_for('admin_passkey_login_start'), passkey_finish_url => url_for('admin_passkey_login_finish'), totp_redirect_url => url_for('admin_totp_challenge'), success_redirect_url => url_for('users_index')
  </div>
</div>
