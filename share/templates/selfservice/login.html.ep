% layout 'selfservice';
% title 'Log In';
<div class="row justify-content-center mt-5">
  <div class="col-sm-10 col-md-6">
    %= include 'partials/login_card', heading => 'Log In', submit_label => 'Log In', login_post_url => url_for('login_post'), passkey_start_url => url_for('passkey_login_start'), passkey_finish_url => url_for('passkey_login_finish'), totp_redirect_url => url_for('totp_challenge'), success_redirect_url => url_for('dashboard'), forgot_url => (reset_available ? url_for('forgot') : undef)
  </div>
</div>
