% layout 'selfservice';
% title 'My Account';

% my $display = $info->{displayName} // ($info->{cn}[0] // $user);
% my $has_lpk = $info->{objectClasses}{ldappublickey} ? 1 : 0;

<h4 class="mb-4">Welcome, <%= $display %></h4>

<!-- Change Password -->
<div class="card border-secondary mb-4">
  <div class="card-header text-danger fw-bold">Change Password</div>
  <div class="card-body">
    <form method="post" action="<%= url_for('change_password') %>">
      <%= csrf_field %>
      <div class="mb-2">
        <label class="form-label" for="current">Current Password</label>
        <input type="password" class="form-control" id="current" name="current"
               autocomplete="current-password" required>
      </div>
      <div class="mb-2">
        <label class="form-label" for="new_pass">New Password</label>
        <input type="password" class="form-control" id="new_pass" name="new_pass"
               autocomplete="new-password" required>
      </div>
      <div class="mb-3">
        <label class="form-label" for="confirm">Confirm New Password</label>
        <input type="password" class="form-control" id="confirm" name="confirm"
               autocomplete="new-password" required>
      </div>
      <button type="submit" class="btn btn-danger btn-sm">Change Password</button>
    </form>
  </div>
</div>

% if ($lpk_schema) {
<!-- SSH Public Keys -->
<div class="card border-secondary mb-4">
  <div class="card-header text-danger fw-bold">SSH Public Keys</div>
  <div class="card-body">
  % if ($has_lpk) {
    % my @keys = @{ $info->{sshPublicKey} };
    % if (@keys) {
    <ul class="list-group list-group-flush mb-3">
      % for my $k (sort @keys) {
      <li class="list-group-item bg-transparent border-secondary d-flex justify-content-between align-items-start gap-2">
        <code class="flex-grow-1 text-break small"><%= $k %></code>
        <form method="post" action="<%= url_for('sshkey_remove') %>"
              data-confirm="Remove this SSH key?"
              class="flex-shrink-0">
          <%= csrf_field %>
          <input type="hidden" name="key" value="<%= $k %>">
          <button type="submit" class="btn btn-outline-danger btn-sm">Remove</button>
        </form>
      </li>
      % }
    </ul>
    % } else {
    <p class="text-secondary small">No SSH keys on file.</p>
    % }
    <button type="button" class="btn btn-outline-secondary btn-sm"
            data-bs-toggle="modal" data-bs-target="#modal-sshkey-add">
      + Add Key
    </button>
  % } else {
    <p class="text-secondary small mb-3">
      SSH key storage is not yet enabled for your account.
      Enable it to store SSH public keys in your LDAP entry.
    </p>
    <form method="post" action="<%= url_for('sshkey_enable') %>">
      <%= csrf_field %>
      <button type="submit" class="btn btn-outline-secondary btn-sm">
        Enable SSH Key Storage
      </button>
    </form>
  % }
  </div>
</div>

% if ($has_lpk) {
<!-- SSH key add modal -->
<div class="modal fade" id="modal-sshkey-add" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header border-secondary">
        <h5 class="modal-title">Add SSH Public Key</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form method="post" action="<%= url_for('sshkey_add') %>">
        <%= csrf_field %>
        <div class="modal-body">
          <label class="form-label" for="key">Public Key</label>
          <textarea class="form-control font-monospace" id="key" name="key"
                    rows="4" required placeholder="ssh-rsa AAAA..."></textarea>
          <div class="form-text text-secondary">Paste your public key (e.g. from ~/.ssh/id_rsa.pub).</div>
        </div>
        <div class="modal-footer border-secondary">
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-danger btn-sm">Add Key</button>
        </div>
      </form>
    </div>
  </div>
</div>
% }

% } # end if $lpk_schema

% if ($totp_schema) {
% my $has_totp = $info->{objectClasses}{totpuser} ? 1 : 0;
% my $new_scratch_codes = flash('new_scratch_codes');
<!-- TOTP / MFA -->
<div class="card border-secondary mb-4">
  <div class="card-header d-flex justify-content-between align-items-center">
    <span class="text-danger fw-bold">TOTP / MFA</span>
    % if ($has_totp) {
    <span class="badge bg-success">Enabled</span>
    % } else {
    <span class="badge bg-secondary">Not enabled</span>
    % }
  </div>
  <div class="card-body">
  % if ($new_scratch_codes && @$new_scratch_codes) {
  <div class="alert alert-warning border-warning mb-3" role="alert">
    <strong>New scratch codes — save these now.</strong>
    They will not be shown again.
    <ul class="mt-2 mb-0 font-monospace">
      % for my $sc (@$new_scratch_codes) {
      <li><%= $sc %></li>
      % }
    </ul>
  </div>
  % }
  % if ($has_totp) {
    <table class="table table-sm mb-3">
      <tbody>
        <tr>
          <th style="width:40%">Status</th>
          <td>
            % if (defined $info->{totpStatus}) {
            <%= $info->{totpStatus} %>
            % } else {
            <span class="text-secondary">not set</span>
            % }
          </td>
        </tr>
        <tr>
          <th>Enrolled</th>
          <td>
            % if (defined $info->{totpEnrolledDate}) {
            <%= $info->{totpEnrolledDate} %>
            % } else {
            <span class="text-secondary">not set</span>
            % }
          </td>
        </tr>
        <tr>
          <th>Algorithm</th>
          <td><%= $info->{totpAlgorithm} // 'SHA1' %></td>
        </tr>
        <tr>
          <th>Period</th>
          <td><%= $info->{totpPeriod} // 30 %>s</td>
        </tr>
        <tr>
          <th>Digits</th>
          <td><%= $info->{totpDigits} // 6 %></td>
        </tr>
        <tr>
          <th>Scratch codes</th>
          <td class="d-flex align-items-center gap-2">
            <span><%= $info->{totpScratchCodeCount} // 0 %> remaining</span>
            <form method="post" action="<%= url_for('totp_scratch_replace') %>"
                  data-confirm="This will replace all existing scratch codes. Continue?">
              <%= csrf_field %>
              <button type="submit" class="btn btn-outline-secondary btn-sm">Replace</button>
            </form>
          </td>
        </tr>
      </tbody>
    </table>
    % if (($info->{totpStatus}//'') eq 'none') {
    <form method="post" action="<%= url_for('totp_generate') %>">
      <%= csrf_field %>
      <button type="submit" class="btn btn-outline-secondary btn-sm">Set up TOTP</button>
    </form>
    % } elsif (($info->{totpStatus}//'') eq 'pending') {
    <div class="mb-3">
      % if ($totp_qr_b64) {
      <p class="text-secondary small mb-2">Scan this QR code with your authenticator app:</p>
      <img src="data:image/png;base64,<%= $totp_qr_b64 %>"
           alt="TOTP QR Code" class="mb-2 d-block" style="max-width:200px">
      % }
      % if ($totp_uri) {
      <details class="mb-3">
        <summary class="text-secondary small" style="cursor:pointer">Show setup URL</summary>
        <div class="mt-2">
          <code class="text-break small d-block p-2 bg-dark rounded" style="word-break:break-all"><%= $totp_uri %></code>
          <div class="form-text">Copy this URL into your authenticator app if you cannot scan the QR code.</div>
        </div>
      </details>
      % }
      <p class="text-secondary small mb-1">Enter a code from your authenticator to verify and activate MFA:</p>
      <form method="post" action="<%= url_for('totp_verify') %>">
        <%= csrf_field %>
        <div class="d-flex gap-2">
          <input type="text" class="form-control form-control-sm" name="code"
                 pattern="\d{6}" maxlength="6" required autocomplete="one-time-code"
                 placeholder="6-digit code" style="width:9rem">
          <button type="submit" class="btn btn-success btn-sm">Verify &amp; Activate</button>
        </div>
      </form>
    </div>
    % }
  % } else {
    <p class="text-secondary small mb-3">
      TOTP/MFA is not yet enabled on your account. Enable it to protect your account
      with a second factor using an authenticator app.
    </p>
    <form method="post" action="<%= url_for('totp_enable') %>">
      <%= csrf_field %>
      <button type="submit" class="btn btn-outline-secondary btn-sm">Enable TOTP</button>
    </form>
  % }
  </div>
</div>


% } # end if $totp_schema

% if ($passkey_schema) {
% my $has_passkey = ($passkey_info && $passkey_info->{hasPasskeyUser}) ? 1 : 0;
% my @pk_creds    = $has_passkey ? @{ $passkey_info->{credentials} // [] } : ();
<!-- Passkeys -->
<div class="card border-secondary mb-4">
  <div class="card-header d-flex justify-content-between align-items-center">
    <span class="text-danger fw-bold">Passkeys</span>
    % if ($has_passkey) {
    <span class="badge bg-success">Enabled</span>
    % } else {
    <span class="badge bg-secondary">Not enabled</span>
    % }
  </div>
  <div class="card-body">
  % if ($has_passkey) {
    % if (@pk_creds) {
    <ul class="list-group list-group-flush mb-3">
      % for my $cred (@pk_creds) {
      <li class="list-group-item bg-transparent border-secondary d-flex justify-content-between align-items-start gap-2">
        <div class="flex-grow-1">
          <div class="small fw-semibold"><%= $cred->{nickname} || 'Unnamed passkey' %></div>
          <div class="text-secondary" style="font-size:.75rem">
            % my $tr = join(', ', @{$cred->{transports} // []});
            <%= $tr || 'unknown transport' %> &middot;
            registered <%= $cred->{createdDate} || 'unknown' %>
            % if ($cred->{lastUsedDate}) {
            &middot; last used <%= $cred->{lastUsedDate} %>
            % }
          </div>
        </div>
        <form method="post" action="<%= url_for('passkey_remove') %>"
              data-confirm="Remove this passkey?" class="flex-shrink-0">
          <%= csrf_field %>
          <input type="hidden" name="credentialId" value="<%= $cred->{credentialId} %>">
          <button type="submit" class="btn btn-outline-danger btn-sm">Remove</button>
        </form>
      </li>
      % }
    </ul>
    % } else {
    <p class="text-secondary small">No passkeys registered yet.</p>
    % }
    <button type="button" class="btn btn-outline-secondary btn-sm" id="pk-add-btn">+ Add Passkey</button>
    <div id="pk-add-form" class="mt-3 d-none">
      <div class="mb-2">
        <label class="form-label small" for="pk-nickname">Nickname <span class="text-secondary">(optional)</span></label>
        <input type="text" class="form-control form-control-sm" id="pk-nickname"
               placeholder="e.g. MacBook Touch ID" maxlength="100">
      </div>
      <div class="d-flex gap-2">
        <button type="button" class="btn btn-danger btn-sm" id="pk-add-go">Register Passkey</button>
        <button type="button" class="btn btn-secondary btn-sm" id="pk-add-cancel">Cancel</button>
      </div>
      <div id="pk-add-status" class="mt-2 small text-secondary d-none"></div>
    </div>
  % } else {
    <p class="text-secondary small mb-3">
      Passkey storage is not yet enabled for your account.
      Enable it to register WebAuthn/FIDO2 passkeys as a second factor.
    </p>
    <form method="post" action="<%= url_for('passkey_enable') %>">
      <%= csrf_field %>
      <button type="submit" class="btn btn-outline-secondary btn-sm">Enable Passkey Storage</button>
    </form>
  % }
  </div>
</div>

% if ($has_passkey) {
<script>
(function () {
  'use strict';

  // Base64url <-> ArrayBuffer helpers
  function b64uToBuf(b64u) {
    var b64 = b64u.replace(/-/g, '+').replace(/_/g, '/');
    while (b64.length % 4) b64 += '=';
    var raw = atob(b64), buf = new Uint8Array(raw.length);
    for (var i = 0; i < raw.length; i++) buf[i] = raw.charCodeAt(i);
    return buf.buffer;
  }
  function bufToB64u(buf) {
    var bytes = new Uint8Array(buf), raw = '';
    for (var i = 0; i < bytes.length; i++) raw += String.fromCharCode(bytes[i]);
    return btoa(raw).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
  }

  var addBtn    = document.getElementById('pk-add-btn');
  var addForm   = document.getElementById('pk-add-form');
  var addGo     = document.getElementById('pk-add-go');
  var addCancel = document.getElementById('pk-add-cancel');
  var status    = document.getElementById('pk-add-status');

  if (!window.PublicKeyCredential) {
    addBtn.disabled = true;
    addBtn.title    = 'This browser does not support passkeys.';
  }

  addBtn.addEventListener('click', function () {
    addForm.classList.remove('d-none');
    addBtn.classList.add('d-none');
  });
  addCancel.addEventListener('click', function () {
    addForm.classList.add('d-none');
    addBtn.classList.remove('d-none');
    status.classList.add('d-none');
  });

  addGo.addEventListener('click', async function () {
    status.textContent = 'Starting\u2026';
    status.classList.remove('d-none');
    addGo.disabled = true;
    try {
      var optResp = await fetch('<%= url_for('passkey_register_start') %>');
      if (!optResp.ok) throw new Error('Server error fetching options');
      var opts = await optResp.json();
      if (opts.error) throw new Error(opts.error);

      opts.challenge = b64uToBuf(opts.challenge);
      opts.user.id   = b64uToBuf(opts.user.id);
      if (opts.excludeCredentials) {
        opts.excludeCredentials = opts.excludeCredentials.map(function (c) {
          return Object.assign({}, c, { id: b64uToBuf(c.id) });
        });
      }

      var cred = await navigator.credentials.create({ publicKey: opts });

      var body = {
        id:       cred.id,
        rawId:    bufToB64u(cred.rawId),
        type:     cred.type,
        nickname: document.getElementById('pk-nickname').value,
        response: {
          clientDataJSON:    bufToB64u(cred.response.clientDataJSON),
          attestationObject: bufToB64u(cred.response.attestationObject),
          transports:        cred.response.getTransports ? cred.response.getTransports() : [],
        },
      };

      var finResp = await fetch('<%= url_for('passkey_register_finish') %>', {
        method:  'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': (document.querySelector('meta[name="csrf-token"]') || {}).content || '',
        },
        body:    JSON.stringify(body),
      });
      var result = await finResp.json();
      if (!finResp.ok) throw new Error(result.error || 'Registration failed');

      window.location.reload();
    } catch (err) {
      status.textContent = 'Error: ' + err.message;
      addGo.disabled = false;
    }
  });
})();
</script>
% } # end if $has_passkey

% } # end if $passkey_schema
