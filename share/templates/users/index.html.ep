% layout 'default';
% title 'Users';

<div class="d-flex justify-content-between align-items-center mb-3">
  <h2>Users</h2>
  <a href="/users/add" class="btn btn-primary">+ Add User</a>
</div>

% if (!@{$users}) {
<div class="alert alert-info">No users found in LDAP.</div>
% } else {

% # Determine which optional columns have at least one value across all users
% my @opt_cols = (
%   [ 'displayName',    'Display Name' ],
%   [ 'sn',             'Surname'      ],
%   [ 'givenName',      'Given Name'   ],
%   [ 'title',          'Title'        ],
%   [ 'employeeNumber', 'Employee #'   ],
%   [ 'employeeType',   'Type'         ],
% );
% my @active_cols = grep { my $attr = $_->[0]; grep { $_->get_value($attr) } @{$users} } @opt_cols;

<div class="table-responsive">
  <table id="users-table" class="table table-striped table-hover table-sm align-middle">
    <thead class="table-dark">
      <tr>
        <th data-col="0" data-type="text"   class="sortable">Username <span class="sort-icon"></span></th>
        <th data-col="1" data-type="number" class="sortable">UID <span class="sort-icon"></span></th>
        <th data-col="2" data-type="number" class="sortable">GID <span class="sort-icon"></span></th>
        <th data-col="3" data-type="text"   class="sortable">GECOS <span class="sort-icon"></span></th>
        <th data-col="4" data-type="text"   class="sortable">Home <span class="sort-icon"></span></th>
        <th data-col="5" data-type="text"   class="sortable">Shell <span class="sort-icon"></span></th>
        % my $col_idx = 6;
        % for my $oc (@active_cols) {
        <th data-col="<%= $col_idx++ %>" data-type="text" class="sortable"><%= $oc->[1] %> <span class="sort-icon"></span></th>
        % }
      </tr>
    </thead>
    <tbody>
      % for my $entry (@{$users}) {
      % my $uid = $entry->get_value('uid');
      <tr>
        <td><a href="/users/<%= $uid %>"><%= $uid %></a></td>
        <td><%= $entry->get_value('uidNumber') %></td>
        <td><%= $entry->get_value('gidNumber') %></td>
        <td><%= $entry->get_value('gecos') // '' %></td>
        <td><code><%= $entry->get_value('homeDirectory') %></code></td>
        <td><code><%= $entry->get_value('loginShell') %></code></td>
        % for my $oc (@active_cols) {
        <td><%= $entry->get_value($oc->[0]) // '' %></td>
        % }
      </tr>
      % }
    </tbody>
  </table>
</div>
% }

<style>
  th.sortable { cursor: pointer; user-select: none; }
  th.sortable:hover { background-color: rgba(255,255,255,.05); }
  .sort-icon::after { content: ' \2195'; opacity: .35; font-size: .75em; }
  th.sort-asc  .sort-icon::after { content: ' \2191'; opacity: 1; }
  th.sort-desc .sort-icon::after { content: ' \2193'; opacity: 1; }
</style>

<script>
(function () {
  var table   = document.getElementById('users-table');
  var tbody   = table.querySelector('tbody');
  var headers = table.querySelectorAll('th.sortable');
  var sortCol = 0, sortAsc = true;

  function sortTable(col, type, asc) {
    var rows = Array.from(tbody.querySelectorAll('tr'));
    rows.sort(function (a, b) {
      var av = a.cells[col].textContent.trim();
      var bv = b.cells[col].textContent.trim();
      var cmp = (type === 'number')
        ? (parseFloat(av) || 0) - (parseFloat(bv) || 0)
        : av.localeCompare(bv);
      return asc ? cmp : -cmp;
    });
    rows.forEach(function (r) { tbody.appendChild(r); });
  }

  headers.forEach(function (th) {
    th.addEventListener('click', function () {
      var col  = parseInt(th.dataset.col);
      var type = th.dataset.type;
      if (sortCol === col) { sortAsc = !sortAsc; } else { sortCol = col; sortAsc = true; }
      headers.forEach(function (h) { h.classList.remove('sort-asc', 'sort-desc'); });
      th.classList.add(sortAsc ? 'sort-asc' : 'sort-desc');
      sortTable(col, type, sortAsc);
    });
  });
})();
</script>
