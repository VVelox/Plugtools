% layout 'default';
% title 'Users';

<div class="d-flex justify-content-between align-items-center mb-3">
  <h2>Users</h2>
  <a href="/users/add" class="btn btn-primary">+ Add User</a>
</div>

% if (!@{$users}) {
<div class="alert alert-info">No users found in LDAP.</div>
% } else {
<div class="table-responsive">
  <table class="table table-striped table-hover table-sm align-middle">
    <thead class="table-dark">
      <tr>
        <th>Username</th>
        <th>UID</th>
        <th>GID</th>
        <th>GECOS</th>
        <th>Home</th>
        <th>Shell</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      % for my $entry (@{$users}) {
      % my $uid = $entry->get_value('uid');
      <tr>
        <td><a href="/users/<%= $uid %>"><%= $uid %></a></td>
        <td><%= $entry->get_value('uidNumber') %></td>
        <td><%= $entry->get_value('gidNumber') %></td>
        <td><%= $entry->get_value('gecos') // '' %></td>
        <td><code><%= $entry->get_value('homeDirectory') %></code></td>
        <td><code><%= $entry->get_value('loginShell') %></code></td>
        <td class="text-end">
          <a href="/users/<%= $uid %>/edit" class="btn btn-outline-secondary btn-sm">Edit</a>
          <form method="post" action="/users/<%= $uid %>/delete" class="d-inline"
                onsubmit="return confirm('Delete user <%= $uid %>?')">
            <button class="btn btn-outline-danger btn-sm">Delete</button>
          </form>
        </td>
      </tr>
      % }
    </tbody>
  </table>
</div>
% }
