<!-- ===== Group membership modal ===== -->

% if (@{$nonmember_groups}) {
<div class="modal fade" id="modal-group-add" tabindex="-1">
  <div class="modal-dialog modal-lg"><div class="modal-content">
    <form method="post" action="/users/<%= $username %>/groups">
      <div class="modal-header">
        <h5 class="modal-title">Add to Groups</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body p-0">
        <table class="table table-sm table-hover mb-0" id="group-add-table">
          <thead>
            <tr>
              <th style="width:1%" class="ps-3">
                <input type="checkbox" id="group-add-all" title="Select all">
              </th>
              <th>Group</th>
              <th>GID</th>
            </tr>
          </thead>
          <tbody>
            % for my $g (@{$nonmember_groups}) {
            % my $gname = $g->get_value('cn');
            <tr style="cursor:pointer" onclick="var cb=this.querySelector('input[type=checkbox]');cb.checked=!cb.checked">
              <td class="ps-3">
                <input type="checkbox" name="group" value="<%= $gname %>"
                       onclick="event.stopPropagation()">
              </td>
              <td><%= $gname %></td>
              <td class="text-muted"><small><%= $g->get_value('gidNumber') %></small></td>
            </tr>
            % }
          </tbody>
        </table>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Add Selected</button>
      </div>
    </form>
  </div></div>
</div>
<script>
document.getElementById('group-add-all').addEventListener('change', function() {
  document.querySelectorAll('#group-add-table input[name=group]').forEach(function(cb) {
    cb.checked = document.getElementById('group-add-all').checked;
  });
});
</script>
% }

<!-- ===== LDAP entry viewer ===== -->
% my %sensitive = map { lc($_) => 1 } qw(userPassword sambaNTPassword sambaLMPassword);
<div class="modal fade" id="modal-ldap-entry" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-scrollable"><div class="modal-content">
    <div class="modal-header">
      <h5 class="modal-title">LDAP Entry: <%= $username %></h5>
      <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>
    <div class="modal-body">
<pre class="mb-0" style="font-size:0.78rem">dn: <%= $entry->dn %>
% for my $attr ($entry->attributes) {
% for my $val ($entry->get_value($attr)) {
% if ($sensitive{lc($attr)}) {
<%= $attr %>: <span class="text-warning fst-italic">&lt;&lt;NOT DISPLAYED&gt;&gt;</span>
% } else {
<%= $attr %>: <%= $val %>
% }
% }
% }
</pre>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
    </div>
  </div></div>
</div>
