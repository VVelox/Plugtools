% layout 'default';
% title $username;

<nav aria-label="breadcrumb" class="mb-3">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/users">Users</a></li>
    <li class="breadcrumb-item active"><%= $username %></li>
  </ol>
</nav>

<div class="row g-4">

  <!-- Attributes -->
  <div class="col-md-6">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <strong>Account: <%= $username %></strong>
        <a href="/users/<%= $username %>/edit" class="btn btn-sm btn-outline-secondary">Edit</a>
      </div>
      <div class="card-body p-0">
        <table class="table table-sm mb-0">
          <tbody>
            <tr><th class="ps-3" style="width:35%">Username</th>
                <td><%= $entry->get_value('uid') %></td></tr>
            <tr><th class="ps-3">UID</th>
                <td><%= $entry->get_value('uidNumber') %></td></tr>
            <tr><th class="ps-3">GID</th>
                <td><%= $entry->get_value('gidNumber') %></td></tr>
            <tr><th class="ps-3">GECOS</th>
                <td><%= $entry->get_value('gecos') // '' %></td></tr>
            <tr><th class="ps-3">Home</th>
                <td><code><%= $entry->get_value('homeDirectory') %></code></td></tr>
            <tr><th class="ps-3">Shell</th>
                <td><code><%= $entry->get_value('loginShell') %></code></td></tr>
            <tr><th class="ps-3">DN</th>
                <td><small class="text-muted"><%= $entry->dn %></small></td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Password -->
  <div class="col-md-6">
    <div class="card">
      <div class="card-header"><strong>Set Password</strong></div>
      <div class="card-body">
        <form method="post" action="/users/<%= $username %>/password">
          <div class="mb-3">
            <label class="form-label">New Password</label>
            <input type="password" name="pass" class="form-control" required>
          </div>
          <button class="btn btn-warning">Set Password</button>
        </form>
      </div>
    </div>
  </div>

</div>

<!-- Danger zone -->
<div class="card border-danger mt-4">
  <div class="card-header text-danger"><strong>Danger Zone</strong></div>
  <div class="card-body">
    <form method="post" action="/users/<%= $username %>/delete"
          onsubmit="return confirm('Permanently delete user <%= $username %>?')">
      <div class="form-check mb-2">
        <input class="form-check-input" type="checkbox" name="removeHome" value="1" id="removeHome">
        <label class="form-check-label" for="removeHome">Remove home directory</label>
      </div>
      <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" name="removeGroup" value="1"
               id="removeGroup" checked>
        <label class="form-check-label" for="removeGroup">Remove primary group if empty</label>
      </div>
      <button class="btn btn-danger">Delete User</button>
    </form>
  </div>
</div>
