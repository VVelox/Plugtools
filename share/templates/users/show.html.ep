% layout 'default';
% title $username;

<nav aria-label="breadcrumb" class="mb-3">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/users">Users</a></li>
    <li class="breadcrumb-item active"><%= $username %></li>
  </ol>
</nav>

<div class="row g-4">

  <!-- Attributes -->
  <div class="col-md-6">
    <div class="card">
      <div class="card-header"><strong>Account: <%= $username %></strong></div>
      <div class="card-body p-0">
        <table class="table table-sm mb-0">
          <tbody>
            <tr>
              <th class="ps-3" style="width:35%">Username</th>
              <td><%= $entry->get_value('uid') %></td>
              <td></td>
            </tr>
            <tr>
              <th class="ps-3">UID</th>
              <td><%= $entry->get_value('uidNumber') %></td>
              <td class="text-end pe-3">
                <button class="btn btn-sm btn-outline-secondary py-0"
                        data-bs-toggle="modal" data-bs-target="#modal-uid">&#9998;</button>
              </td>
            </tr>
            <tr>
              <th class="ps-3">GID</th>
              <td><%= $entry->get_value('gidNumber') %></td>
              <td class="text-end pe-3">
                <button class="btn btn-sm btn-outline-secondary py-0"
                        data-bs-toggle="modal" data-bs-target="#modal-gid">&#9998;</button>
              </td>
            </tr>
            <tr>
              <th class="ps-3">GECOS</th>
              <td><%= $entry->get_value('gecos') // '' %></td>
              <td class="text-end pe-3">
                <button class="btn btn-sm btn-outline-secondary py-0"
                        data-bs-toggle="modal" data-bs-target="#modal-gecos">&#9998;</button>
              </td>
            </tr>
            <tr>
              <th class="ps-3">Home</th>
              <td><code><%= $entry->get_value('homeDirectory') %></code></td>
              <td class="text-end pe-3">
                <button class="btn btn-sm btn-outline-secondary py-0"
                        data-bs-toggle="modal" data-bs-target="#modal-home">&#9998;</button>
              </td>
            </tr>
            <tr>
              <th class="ps-3">Shell</th>
              <td><code><%= $entry->get_value('loginShell') %></code></td>
              <td class="text-end pe-3">
                <button class="btn btn-sm btn-outline-secondary py-0"
                        data-bs-toggle="modal" data-bs-target="#modal-shell">&#9998;</button>
              </td>
            </tr>
            <tr>
              <th class="ps-3">DN</th>
              <td colspan="2"><small class="text-muted"><%= $entry->dn %></small></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Password -->
  <div class="col-md-6">
    <div class="card">
      <div class="card-header"><strong>Set Password</strong></div>
      <div class="card-body">
        <form method="post" action="/users/<%= $username %>/password">
          <div class="mb-3">
            <label class="form-label">New Password</label>
            <input type="password" name="pass" class="form-control" required>
          </div>
          <button class="btn btn-warning">Set Password</button>
        </form>
      </div>
    </div>
  </div>

</div>

<!-- Danger zone -->
<div class="card border-danger mt-4">
  <div class="card-header text-danger"><strong>Danger Zone</strong></div>
  <div class="card-body">
    <form method="post" action="/users/<%= $username %>/delete"
          onsubmit="return confirm('Permanently delete user <%= $username %>?')">
      <div class="form-check mb-2">
        <input class="form-check-input" type="checkbox" name="removeHome" value="1" id="removeHome">
        <label class="form-check-label" for="removeHome">Remove home directory</label>
      </div>
      <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" name="removeGroup" value="1"
               id="removeGroup" checked>
        <label class="form-check-label" for="removeGroup">Remove primary group if empty</label>
      </div>
      <button class="btn btn-danger">Delete User</button>
    </form>
  </div>
</div>

<!-- Edit GECOS modal -->
<div class="modal fade" id="modal-gecos" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="post" action="/users/<%= $username %>">
        <input type="hidden" name="action" value="gecos">
        <div class="modal-header">
          <h5 class="modal-title">Edit GECOS</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <label class="form-label">GECOS / Full Name</label>
          <input type="text" name="gecos" class="form-control"
                 value="<%= $entry->get_value('gecos') // '' %>">
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Save</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Edit Shell modal -->
<div class="modal fade" id="modal-shell" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="post" action="/users/<%= $username %>">
        <input type="hidden" name="action" value="shell">
        <div class="modal-header">
          <h5 class="modal-title">Edit Shell</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <label class="form-label">Login Shell</label>
          <input type="text" name="shell" class="form-control"
                 value="<%= $entry->get_value('loginShell') // '' %>">
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Save</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Edit UID modal -->
<div class="modal fade" id="modal-uid" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="post" action="/users/<%= $username %>">
        <input type="hidden" name="action" value="uid">
        <div class="modal-header">
          <h5 class="modal-title">Edit UID</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <label class="form-label">UID Number</label>
          <input type="number" name="uid" class="form-control" min="0"
                 value="<%= $entry->get_value('uidNumber') %>">
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Save</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Edit Home modal -->
<div class="modal fade" id="modal-home" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="post" action="/users/<%= $username %>">
        <input type="hidden" name="action" value="home">
        <div class="modal-header">
          <h5 class="modal-title">Edit Home Directory</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <label class="form-label">Home Directory</label>
          <input type="text" name="home" class="form-control"
                 value="<%= $entry->get_value('homeDirectory') // '' %>">
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Save</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Edit GID modal -->
<div class="modal fade" id="modal-gid" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="post" action="/users/<%= $username %>">
        <input type="hidden" name="action" value="gid">
        <div class="modal-header">
          <h5 class="modal-title">Edit GID</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <label class="form-label">GID Number</label>
          <input type="number" name="gid" class="form-control" min="0"
                 value="<%= $entry->get_value('gidNumber') %>">
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Save</button>
        </div>
      </form>
    </div>
  </div>
</div>
