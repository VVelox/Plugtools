% layout 'default';
% title $username;

<nav aria-label="breadcrumb" class="mb-3">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/users">Users</a></li>
    <li class="breadcrumb-item active"><%= $username %></li>
  </ol>
</nav>

<div class="row g-4">

  <!-- Left column: POSIX Attributes + Contact & Profile -->
  <div class="col-lg-6 d-flex flex-column gap-4">

    <!-- POSIX Attributes -->
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <strong>Account: <%= $username %></strong>
        <button class="btn btn-sm btn-outline-secondary py-0"
                data-bs-toggle="modal" data-bs-target="#modal-ldap-entry">View LDAP</button>
      </div>
      <div class="card-body p-0">
        <table class="table table-sm mb-0">
          <tbody>
            <tr>
              <th class="ps-3" style="width:20%">Username</th>
              <td><%= $entry->get_value('uid') %></td>
              <td></td>
            </tr>
            % my @cn_vals = $entry->get_value('cn');
            <tr>
              <th class="ps-3 align-top">CN</th>
              <td colspan="2" class="pe-3">
                % for my $cn_val (sort @cn_vals) {
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <span><%= $cn_val %></span>
                  % if (@cn_vals > 1) {
                  <form method="post" action="/users/<%= $username %>" class="d-inline ms-2 flex-shrink-0"
                        data-confirm="Remove CN value &#39;<%= $cn_val %>&#39;?">
                    <input type="hidden" name="action" value="cn_remove">
                    <input type="hidden" name="cn" value="<%= $cn_val %>">
                    <button class="btn btn-outline-danger btn-sm py-0" title="Remove">&#10005;</button>
                  </form>
                  % } else {
                  <span data-bs-toggle="tooltip" title="Cannot remove the last CN value">
                    <button class="btn btn-outline-danger btn-sm py-0" disabled>&#10005;</button>
                  </span>
                  % }
                % }
                <div class="mt-1">
                  <button class="btn btn-sm btn-outline-primary py-0"
                          data-bs-toggle="modal" data-bs-target="#modal-cn-add">+ Add</button>
                </div>
              </td>
            </tr>
            <tr>
              <th class="ps-3">UID</th>
              <td><%= $entry->get_value('uidNumber') %></td>
              <td class="text-end pe-3">
                <button class="btn btn-sm btn-outline-secondary py-0"
                        data-bs-toggle="modal" data-bs-target="#modal-uid">&#9998;</button>
              </td>
            </tr>
            <tr>
              <th class="ps-3">GID</th>
              <td><%= $entry->get_value('gidNumber') %></td>
              <td class="text-end pe-3">
                <button class="btn btn-sm btn-outline-secondary py-0"
                        data-bs-toggle="modal" data-bs-target="#modal-gid">&#9998;</button>
              </td>
            </tr>
            <tr>
              <th class="ps-3">GECOS</th>
              <td><%= $entry->get_value('gecos') // '' %></td>
              <td class="text-end pe-3">
                <button class="btn btn-sm btn-outline-secondary py-0"
                        data-bs-toggle="modal" data-bs-target="#modal-gecos">&#9998;</button>
              </td>
            </tr>
            <tr>
              <th class="ps-3">Home</th>
              <td><code><%= $entry->get_value('homeDirectory') %></code></td>
              <td class="text-end pe-3">
                <button class="btn btn-sm btn-outline-secondary py-0"
                        data-bs-toggle="modal" data-bs-target="#modal-home">&#9998;</button>
              </td>
            </tr>
            <tr>
              <th class="ps-3">Shell</th>
              <td><code><%= $entry->get_value('loginShell') %></code></td>
              <td class="text-end pe-3">
                <button class="btn btn-sm btn-outline-secondary py-0"
                        data-bs-toggle="modal" data-bs-target="#modal-shell">&#9998;</button>
              </td>
            </tr>
            <tr>
              <th class="ps-3">DN</th>
              <td colspan="2"><small class="text-muted"><%= $entry->dn %></small></td>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="card-footer d-flex justify-content-end gap-2">
        % if ($has_password) {
        <button class="btn btn-outline-danger btn-sm"
                data-bs-toggle="modal" data-bs-target="#modal-password-remove">Remove Password</button>
        % } else {
        <span data-bs-toggle="tooltip" data-bs-placement="top"
              title="This user has no userPassword attribute">
          <button class="btn btn-outline-danger btn-sm" disabled>Remove Password</button>
        </span>
        % }
        <button class="btn btn-warning btn-sm"
                data-bs-toggle="modal" data-bs-target="#modal-password">Set Password</button>
      </div>
    </div>

    <!-- Contact & Profile -->
    % if (grep { lc($_) eq 'inetorgperson' } $entry->get_value('objectClass')) {
    <div class="card">
      <div class="card-header"><strong>Contact &amp; Profile</strong></div>
      <div class="card-body p-0">
        <table class="table table-sm mb-0">
          <tbody>

            <!-- Single-value fields -->
            % for my $sf (
            %   [ 'displayName',        'Display Name',   'modal-displayName'        ],
            %   [ 'sn',                 'Surname',        'modal-sn'                 ],
            %   [ 'givenName',          'Given Name',     'modal-givenName'          ],
            %   [ 'title',              'Title',          'modal-title'              ],
            %   [ 'employeeNumber',     'Employee #',     'modal-employeeNumber'     ],
            %   [ 'employeeType',       'Employee Type',  'modal-employeeType'       ],
            %   [ 'roomNumber',         'Room',           'modal-roomNumber'         ],
            %   [ 'homePostalAddress',  'Home Address',   'modal-homePostalAddress'  ],
            % ) {
            % my ($sattr, $slabel, $smodal) = @{$sf};
            <tr>
              <th class="ps-3" style="width:20%"><%= $slabel %></th>
              <td><%= $entry->get_value($sattr) // '' %></td>
              <td class="text-end pe-3" style="width:1%">
                <button class="btn btn-sm btn-outline-secondary py-0"
                        data-bs-toggle="modal" data-bs-target="#<%= $smodal %>">&#9998;</button>
              </td>
            </tr>
            % }

            <!-- Multi-value fields -->
            % for my $field (
            %   [ 'mail',              'Mail',        'modal-mail-add'   ],
            %   [ 'telephoneNumber',   'Telephone',   'modal-tel-add'    ],
            %   [ 'mobile',            'Mobile',      'modal-mobile-add' ],
            %   [ 'preferredLanguage', 'Language',    'modal-lang-add'   ],
            %   [ 'description',       'Description', 'modal-desc-add'   ],
            %   [ 'postalAddress',     'Address',     'modal-addr-add'   ],
            %   [ 'labeledURI',        'URI',         'modal-uri-add'    ],
            % ) {
            % my ($attr, $label, $modal) = @{$field};
            % my @vals = $entry->get_value($attr);
            <tr>
              <th class="ps-3 align-top"><%= $label %></th>
              <td colspan="2" class="pe-3">
                % if (@vals) {
                % for my $val (sort @vals) {
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <span class="text-break"><%= $val %></span>
                  <form method="post" action="/users/<%= $username %>" class="d-inline ms-2 flex-shrink-0">
                    <input type="hidden" name="action" value="<%= $attr %>_remove">
                    <input type="hidden" name="<%= $attr %>" value="<%= $val %>">
                    <button class="btn btn-outline-danger btn-sm py-0" title="Remove"
                            onclick="return confirm('Remove this value?')">&#10005;</button>
                  </form>
                </div>
                % }
                % } else {
                <span class="text-muted">—</span>
                % }
                <div class="mt-2">
                  <button class="btn btn-sm btn-outline-primary py-0"
                          data-bs-toggle="modal" data-bs-target="#<%= $modal %>">+ Add</button>
                </div>
              </td>
            </tr>
            % }

          </tbody>
        </table>
      </div>
    </div>
    % } else {
    <!-- Convert to inetOrgPerson -->
    <div class="card">
      <div class="card-header"><strong>Contact &amp; Profile</strong></div>
      <div class="card-body">
        <p class="mb-3 text-muted">
          This account does not have the <code>inetOrgPerson</code> objectClass.
          Converting it enables contact and profile fields such as email, phone,
          display name, and postal address.
        </p>
        <form method="post" action="/users/<%= $username %>/inetorgperson"
              data-confirm="Convert <%= $username %> to inetOrgPerson?">
          <button class="btn btn-outline-primary">Convert to inetOrgPerson</button>
        </form>
      </div>
    </div>
    % } # end inetOrgPerson else

  </div>

  <!-- Right column: Group Memberships -->
  <div class="col-lg-6">
    <div class="card h-100">
      <div class="card-header d-flex justify-content-between align-items-center">
        <strong>Group Memberships</strong>
        % if (@{$nonmember_groups}) {
        <button class="btn btn-sm btn-outline-primary py-0"
                data-bs-toggle="modal" data-bs-target="#modal-group-add">+ Add to Group</button>
        % }
      </div>
      <div class="card-body p-0">
        % if (@{$member_groups}) {
        <table class="table table-sm mb-0">
          <tbody>
            % for my $g (@{$member_groups}) {
            % my $gname = $g->get_value('cn');
            <tr>
              <td class="ps-3"><a href="/groups/<%= $gname %>"><%= $gname %></a></td>
              <td class="text-muted"><small>GID <%= $g->get_value('gidNumber') %></small></td>
              <td class="text-end pe-3">
                <form method="post" action="/users/<%= $username %>/groups/<%= $gname %>/remove"
                      data-confirm="Remove <%= $username %> from group <%= $gname %>?"
                      class="d-inline">
                  <button class="btn btn-outline-danger btn-sm py-0" title="Remove from group">&#10005;</button>
                </form>
              </td>
            </tr>
            % }
          </tbody>
        </table>
        % } else {
        <p class="text-muted p-3 mb-0">Not a member of any supplementary groups.</p>
        % }
      </div>
    </div>
  </div>

</div>


<!-- Danger zone -->
<div class="card border-danger mt-4">
  <div class="card-header text-danger"><strong>Danger Zone</strong></div>
  <div class="card-body">
    <form method="post" action="/users/<%= $username %>/delete"
          data-confirm="Permanently delete user <%= $username %>?">
      <div class="form-check mb-2">
        <input class="form-check-input" type="checkbox" name="removeHome" value="1" id="removeHome">
        <label class="form-check-label" for="removeHome">Remove home directory</label>
      </div>
      <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" name="removeGroup" value="1"
               id="removeGroup" checked>
        <label class="form-check-label" for="removeGroup">Remove primary group if empty</label>
      </div>
      <button class="btn btn-danger">Delete User</button>
    </form>
  </div>
</div>

<!-- ===== POSIX modals ===== -->

<div class="modal fade" id="modal-cn-add" tabindex="-1">
  <div class="modal-dialog"><div class="modal-content">
    <form method="post" action="/users/<%= $username %>">
      <input type="hidden" name="action" value="cn_add">
      <div class="modal-header">
        <h5 class="modal-title">Add CN Value</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <label class="form-label">Common Name</label>
        <input type="text" name="cn" class="form-control" required
               placeholder="e.g. Jane Doe">
        <div class="form-text">Additional CN values supplement the primary name used for LDAP lookups.</div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Add</button>
      </div>
    </form>
  </div></div>
</div>

<div class="modal fade" id="modal-password-remove" tabindex="-1">
  <div class="modal-dialog"><div class="modal-content">
    <form method="post" action="/users/<%= $username %>/password/remove">
      <div class="modal-header">
        <h5 class="modal-title">Remove Password</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="alert alert-danger py-2 mb-3">
          <strong>This will disable password-based authentication</strong> for
          <strong><%= $username %></strong>.
        </div>
        <p>
          Removing the <code>userPassword</code> attribute means this account will no longer
          be able to authenticate using a password. Any service that relies on LDAP password
          binding for this user will stop working immediately.
        </p>
        <p class="mb-0">Are you sure you want to continue?</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-danger">Remove Password</button>
      </div>
    </form>
  </div></div>
</div>

<div class="modal fade" id="modal-password" tabindex="-1">
  <div class="modal-dialog"><div class="modal-content">
    <form method="post" action="/users/<%= $username %>/password">
      <div class="modal-header">
        <h5 class="modal-title">Set Password</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        % unless ($has_password) {
        <div class="alert alert-warning py-2 mb-3">
          <strong>No password set.</strong>
          This account currently has no <code>userPassword</code> attribute.
          Setting one will enable password-based authentication.
        </div>
        % }
        <div class="mb-3">
          <label class="form-label">New Password</label>
          <input type="password" name="pass" id="pw-new" class="form-control" required autocomplete="new-password">
        </div>
        <div>
          <label class="form-label">Confirm Password</label>
          <input type="password" id="pw-confirm" class="form-control" required autocomplete="new-password">
          <div class="invalid-feedback">Passwords do not match.</div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-warning">Set Password</button>
      </div>
    </form>
    <script>
    (function () {
      var form    = document.querySelector('#modal-password form');
      var pwNew   = document.getElementById('pw-new');
      var pwConf  = document.getElementById('pw-confirm');

      function validate() {
        if (pwNew.value !== pwConf.value) {
          pwConf.setCustomValidity('Passwords do not match.');
          pwConf.classList.add('is-invalid');
        } else {
          pwConf.setCustomValidity('');
          pwConf.classList.remove('is-invalid');
        }
      }

      pwNew.addEventListener('input', validate);
      pwConf.addEventListener('input', validate);

      /* Clear fields and validation state each time the modal opens */
      document.getElementById('modal-password').addEventListener('show.bs.modal', function () {
        pwNew.value  = '';
        pwConf.value = '';
        pwConf.setCustomValidity('');
        pwConf.classList.remove('is-invalid');
      });
    }());
    </script>
  </div></div>
</div>

<div class="modal fade" id="modal-gecos" tabindex="-1">
  <div class="modal-dialog"><div class="modal-content">
    <form method="post" action="/users/<%= $username %>">
      <input type="hidden" name="action" value="gecos">
      <div class="modal-header">
        <h5 class="modal-title">Edit GECOS</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <label class="form-label">GECOS / Full Name</label>
        <input type="text" name="gecos" class="form-control"
               value="<%= $entry->get_value('gecos') // '' %>">
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
      </div>
    </form>
  </div></div>
</div>

<div class="modal fade" id="modal-shell" tabindex="-1">
  <div class="modal-dialog"><div class="modal-content">
    <form method="post" action="/users/<%= $username %>">
      <input type="hidden" name="action" value="shell">
      <div class="modal-header">
        <h5 class="modal-title">Edit Shell</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <label class="form-label">Login Shell</label>
        <input type="text" name="shell" class="form-control" list="shell-list"
               value="<%= $entry->get_value('loginShell') // '' %>">
        <datalist id="shell-list">
          % for my $sh (@{$shells}) {
          <option value="<%= $sh %>">
          % }
        </datalist>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
      </div>
    </form>
  </div></div>
</div>

<div class="modal fade" id="modal-uid" tabindex="-1">
  <div class="modal-dialog"><div class="modal-content">
    <form method="post" action="/users/<%= $username %>">
      <input type="hidden" name="action" value="uid">
      <div class="modal-header">
        <h5 class="modal-title">Edit UID</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <label class="form-label">UID Number</label>
        <input type="number" name="uid" class="form-control" min="0"
               value="<%= $entry->get_value('uidNumber') %>">
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
      </div>
    </form>
  </div></div>
</div>

<div class="modal fade" id="modal-gid" tabindex="-1">
  <div class="modal-dialog"><div class="modal-content">
    <form method="post" action="/users/<%= $username %>">
      <input type="hidden" name="action" value="gid">
      <div class="modal-header">
        <h5 class="modal-title">Edit GID</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <label class="form-label">GID Number</label>
        <input type="number" name="gid" class="form-control" min="0"
               value="<%= $entry->get_value('gidNumber') %>">
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
      </div>
    </form>
  </div></div>
</div>

<div class="modal fade" id="modal-home" tabindex="-1">
  <div class="modal-dialog"><div class="modal-content">
    <form method="post" action="/users/<%= $username %>">
      <input type="hidden" name="action" value="home">
      <div class="modal-header">
        <h5 class="modal-title">Edit Home Directory</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <label class="form-label">Home Directory</label>
        <input type="text" name="home" class="form-control"
               value="<%= $entry->get_value('homeDirectory') // '' %>">
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
      </div>
    </form>
  </div></div>
</div>

<!-- ===== inetOrgPerson single-value modals ===== -->

<div class="modal fade" id="modal-sn" tabindex="-1">
  <div class="modal-dialog"><div class="modal-content">
    <form method="post" action="/users/<%= $username %>">
      <input type="hidden" name="action" value="sn">
      <div class="modal-header">
        <h5 class="modal-title">Edit Surname</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <label class="form-label">Surname</label>
        <input type="text" name="sn" class="form-control"
               value="<%= $entry->get_value('sn') // '' %>">
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
      </div>
    </form>
  </div></div>
</div>

<div class="modal fade" id="modal-givenName" tabindex="-1">
  <div class="modal-dialog"><div class="modal-content">
    <form method="post" action="/users/<%= $username %>">
      <input type="hidden" name="action" value="givenName">
      <div class="modal-header">
        <h5 class="modal-title">Edit Given Name</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <label class="form-label">Given Name</label>
        <input type="text" name="givenName" class="form-control"
               value="<%= $entry->get_value('givenName') // '' %>">
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
      </div>
    </form>
  </div></div>
</div>

<div class="modal fade" id="modal-displayName" tabindex="-1">
  <div class="modal-dialog"><div class="modal-content">
    <form method="post" action="/users/<%= $username %>">
      <input type="hidden" name="action" value="displayName">
      <div class="modal-header">
        <h5 class="modal-title">Edit Display Name</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <label class="form-label">Display Name</label>
        <input type="text" name="displayName" class="form-control"
               value="<%= $entry->get_value('displayName') // '' %>">
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
      </div>
    </form>
  </div></div>
</div>

<div class="modal fade" id="modal-homePostalAddress" tabindex="-1">
  <div class="modal-dialog"><div class="modal-content">
    <form method="post" action="/users/<%= $username %>">
      <input type="hidden" name="action" value="homePostalAddress">
      <div class="modal-header">
        <h5 class="modal-title">Edit Home Address</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <label class="form-label">Home Postal Address</label>
        <input type="text" name="homePostalAddress" class="form-control"
               value="<%= $entry->get_value('homePostalAddress') // '' %>">
        <div class="form-text">Use <code>$</code> as the line separator, e.g. <code>123 Main St$City$State ZIP$Country</code></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
      </div>
    </form>
  </div></div>
</div>

<div class="modal fade" id="modal-title" tabindex="-1">
  <div class="modal-dialog"><div class="modal-content">
    <form method="post" action="/users/<%= $username %>">
      <input type="hidden" name="action" value="title">
      <div class="modal-header">
        <h5 class="modal-title">Edit Title</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <label class="form-label">Job Title</label>
        <input type="text" name="title" class="form-control"
               value="<%= $entry->get_value('title') // '' %>">
      </div>
