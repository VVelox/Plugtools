% layout 'default';
% title "Edit: $username";

<nav aria-label="breadcrumb" class="mb-3">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/users">Users</a></li>
    <li class="breadcrumb-item"><a href="/users/<%= $username %>"><%= $username %></a></li>
    <li class="breadcrumb-item active">Edit</li>
  </ol>
</nav>

<h4 class="mb-4">Edit: <%= $username %></h4>

<div class="row g-4" style="max-width:900px">

  <!-- GECOS -->
  <div class="col-md-6">
    <div class="card h-100">
      <div class="card-header">GECOS</div>
      <div class="card-body">
        <form method="post" action="/users/<%= $username %>">
          <input type="hidden" name="action" value="gecos">
          <div class="mb-3">
            <label class="form-label">GECOS field</label>
            <input type="text" name="gecos" class="form-control" required
                   value="<%= $entry->get_value('gecos') // '' %>">
          </div>
          <button class="btn btn-primary btn-sm">Update GECOS</button>
        </form>
      </div>
    </div>
  </div>

  <!-- Shell -->
  <div class="col-md-6">
    <div class="card h-100">
      <div class="card-header">Login Shell</div>
      <div class="card-body">
        <form method="post" action="/users/<%= $username %>">
          <input type="hidden" name="action" value="shell">
          <div class="mb-3">
            <label class="form-label">Shell</label>
            <input type="text" name="shell" class="form-control" required
                   value="<%= $entry->get_value('loginShell') // '' %>">
          </div>
          <button class="btn btn-primary btn-sm">Update Shell</button>
        </form>
      </div>
    </div>
  </div>

  <!-- UID -->
  <div class="col-md-6">
    <div class="card h-100">
      <div class="card-header">UID</div>
      <div class="card-body">
        <form method="post" action="/users/<%= $username %>">
          <input type="hidden" name="action" value="uid">
          <div class="mb-3">
            <label class="form-label">UID Number</label>
            <input type="number" name="uid" class="form-control" required
                   value="<%= $entry->get_value('uidNumber') %>">
          </div>
          <button class="btn btn-warning btn-sm">Update UID</button>
        </form>
      </div>
    </div>
  </div>

  <!-- GID -->
  <div class="col-md-6">
    <div class="card h-100">
      <div class="card-header">Primary GID</div>
      <div class="card-body">
        <form method="post" action="/users/<%= $username %>">
          <input type="hidden" name="action" value="gid">
          <div class="mb-3">
            <label class="form-label">GID Number</label>
            <input type="number" name="gid" class="form-control" required
                   value="<%= $entry->get_value('gidNumber') %>">
          </div>
          <button class="btn btn-warning btn-sm">Update GID</button>
        </form>
      </div>
    </div>
  </div>

</div>

<div class="mt-3">
  <a href="/users/<%= $username %>" class="btn btn-outline-secondary">← Back</a>
</div>
