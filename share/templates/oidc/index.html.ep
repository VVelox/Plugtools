% layout 'default';
% title 'OIDC Clients';

<div class="d-flex justify-content-between align-items-center mb-3">
  <h2>OIDC Clients</h2>
  <a href="/oidc/add" class="btn btn-primary">+ Add Client</a>
</div>

% if (!@{$clients}) {
<div class="alert alert-info">No OIDC client registrations found.</div>
% } else {
<div class="table-responsive">
  <table id="oidc-table" class="table table-striped table-hover table-sm align-middle">
    <thead class="table-dark">
      <tr>
        <th data-col="0" data-type="text"   class="sortable">Client ID <span class="sort-icon"></span></th>
        <th data-col="1" data-type="text"   class="sortable">Name <span class="sort-icon"></span></th>
        <th data-col="2" data-type="text"   class="sortable">Type <span class="sort-icon"></span></th>
        <th data-col="3" data-type="text"   class="sortable">Auth Method <span class="sort-icon"></span></th>
        <th data-col="4" data-type="number" class="sortable">Redirect URIs <span class="sort-icon"></span></th>
        <th data-col="5" data-type="text"   class="sortable">Scopes <span class="sort-icon"></span></th>
        <th data-col="6" data-type="text"   class="sortable">Grant Types <span class="sort-icon"></span></th>
      </tr>
    </thead>
    <tbody>
      % for my $entry (@{$clients}) {
      % my $id     = $entry->get_value('oidcClientId')                 // '';
      % my $name   = $entry->get_value('oidcClientName')               // '';
      % my $type   = $entry->get_value('oidcApplicationType')          // 'web';
      % my $auth   = $entry->get_value('oidcTokenEndpointAuthMethod')  // 'client_secret_basic';
      % my %am_labels = ('client_secret_basic'=>'HTTP Basic', 'client_secret_post'=>'POST Body',
      %   'client_secret_jwt'=>'JWT (Shared Secret)', 'private_key_jwt'=>'JWT (Private Key)', 'none'=>'None (Public)');
      % my @uris   = $entry->get_value('oidcRedirectURI');
      % my @scopes = $entry->get_value('oidcScope');
      % my @grants = $entry->get_value('oidcGrantType');
      <tr>
        <td><a href="/oidc/<%= $id %>"><%= $id %></a></td>
        <td><%= $name %></td>
        <td><span class="badge bg-<%= $type eq 'native' ? 'info' : 'secondary' %>"><%= $type %></span></td>
        <td><small><%= $am_labels{$auth} // $auth %></small></td>
        <td data-sort="<%= scalar @uris %>"><%= scalar @uris %></td>
        <td>
          % if (@scopes) {
            <small class="text-muted"><%= join(', ', sort @scopes) %></small>
          % } else {
            <span class="text-muted">-</span>
          % }
        </td>
        <td>
          % if (@grants) {
            <small class="text-muted"><%= join(', ', sort @grants) %></small>
          % } else {
            <span class="text-muted">-</span>
          % }
        </td>
      </tr>
      % }
    </tbody>
  </table>
</div>
% }

<style>
  th.sortable { cursor: pointer; user-select: none; }
  th.sortable:hover { background-color: rgba(255,255,255,.05); }
  .sort-icon::after { content: ' \2195'; opacity: .35; font-size: .75em; }
  th.sort-asc  .sort-icon::after { content: ' \2191'; opacity: 1; }
  th.sort-desc .sort-icon::after { content: ' \2193'; opacity: 1; }
</style>

<script>
(function () {
  var table   = document.getElementById('oidc-table');
  if (!table) return;
  var tbody   = table.querySelector('tbody');
  var headers = table.querySelectorAll('th.sortable');
  var sortCol = 0, sortAsc = true;

  function cellValue(row, col, type) {
    var cell = row.cells[col];
    if (cell.dataset.sort !== undefined) return cell.dataset.sort;
    return cell.textContent.trim();
  }

  function sortTable(col, type, asc) {
    var rows = Array.from(tbody.querySelectorAll('tr'));
    rows.sort(function (a, b) {
      var av = cellValue(a, col, type);
      var bv = cellValue(b, col, type);
      var cmp = (type === 'number')
        ? (parseFloat(av) || 0) - (parseFloat(bv) || 0)
        : av.localeCompare(bv);
      return asc ? cmp : -cmp;
    });
    rows.forEach(function (r) { tbody.appendChild(r); });
  }

  headers.forEach(function (th) {
    th.addEventListener('click', function () {
      var col  = parseInt(th.dataset.col);
      var type = th.dataset.type;
      if (sortCol === col) { sortAsc = !sortAsc; } else { sortCol = col; sortAsc = true; }
      headers.forEach(function (h) { h.classList.remove('sort-asc', 'sort-desc'); });
      th.classList.add(sortAsc ? 'sort-asc' : 'sort-desc');
      sortTable(col, type, sortAsc);
    });
  });
})();
</script>
