% layout 'default';
% title $clientId;

<nav aria-label="breadcrumb" class="mb-3">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/oidc">OIDC Clients</a></li>
    <li class="breadcrumb-item active"><%= $clientId %></li>
  </ol>
</nav>

<div class="row g-4">

  <!-- Identity & Core -->
  <div class="col-md-6">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <strong>Client: <%= $clientId %></strong>
        <button class="btn btn-sm btn-outline-secondary py-0"
                data-bs-toggle="modal" data-bs-target="#modal-ldap-entry">View LDAP</button>
      </div>
      <div class="card-body p-0">
        <table class="table table-sm mb-0">
          <tbody>
            <tr>
              <th class="ps-3" style="width:40%">Client ID</th>
              <td><code><%= $entry->get_value('oidcClientId') %></code></td>
              <td></td>
            </tr>
            <tr>
              <th class="ps-3">Client Name</th>
              <td><%= $entry->get_value('oidcClientName') // '' %></td>
              <td class="text-end pe-3">
                <button class="btn btn-sm btn-outline-secondary py-0"
                        data-bs-toggle="modal" data-bs-target="#modal-clientName">&#9998;</button>
              </td>
            </tr>
            <tr>
              <th class="ps-3">Client Secret</th>
              <td>
                % if ($entry->get_value('oidcClientSecret')) {
                  <span class="text-warning fst-italic">&lt;set&gt;</span>
                % } else {
                  <span class="text-muted">not set (public)</span>
                % }
              </td>
              <td class="text-end pe-3">
                <button class="btn btn-sm btn-outline-secondary py-0"
                        data-bs-toggle="modal" data-bs-target="#modal-clientSecret">&#9998;</button>
              </td>
            </tr>
            <tr>
              <th class="ps-3">Application Type</th>
              <td><%= $entry->get_value('oidcApplicationType') // 'web' %></td>
              <td class="text-end pe-3">
                <button class="btn btn-sm btn-outline-secondary py-0"
                        data-bs-toggle="modal" data-bs-target="#modal-applicationType">&#9998;</button>
              </td>
            </tr>
            <tr>
              <th class="ps-3">Auth Method</th>
              <td><%= $entry->get_value('oidcTokenEndpointAuthMethod') // 'client_secret_basic' %></td>
              <td class="text-end pe-3">
                <button class="btn btn-sm btn-outline-secondary py-0"
                        data-bs-toggle="modal" data-bs-target="#modal-authMethod">&#9998;</button>
              </td>
            </tr>
            <tr>
              <th class="ps-3">Subject Type</th>
              <td><%= $entry->get_value('oidcSubjectType') // 'public' %></td>
              <td class="text-end pe-3">
                <button class="btn btn-sm btn-outline-secondary py-0"
                        data-bs-toggle="modal" data-bs-target="#modal-subjectType">&#9998;</button>
              </td>
            </tr>
            <tr>
              <th class="ps-3">DN</th>
              <td colspan="2"><small class="text-muted"><%= $entry->dn %></small></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- URIs -->
  <div class="col-md-6">
    <div class="card">
      <div class="card-header"><strong>URIs</strong></div>
      <div class="card-body p-0">
        <table class="table table-sm mb-0">
          <tbody>
            % my @uri_fields = (
            %   ['clientURI',            'oidcClientURI',            'Client URI'],
            %   ['logoURI',              'oidcLogoURI',              'Logo URI'],
            %   ['policyURI',            'oidcPolicyURI',            'Policy URI'],
            %   ['tosURI',               'oidcTosURI',               'ToS URI'],
            %   ['jwksURI',              'oidcJwksURI',              'JWKS URI'],
            %   ['initiateLoginURI',     'oidcInitiateLoginURI',     'Initiate Login URI'],
            %   ['sectorIdentifierURI',  'oidcSectorIdentifierURI',  'Sector Identifier URI'],
            % );
            % for my $uf (@uri_fields) {
            <tr>
              <th class="ps-3" style="width:40%"><%= $uf->[2] %></th>
              <td>
                % my $uv = $entry->get_value($uf->[1]) // '';
                % if ($uv) {
                  <small><%= $uv %></small>
                % } else {
                  <span class="text-muted">-</span>
                % }
              </td>
              <td class="text-end pe-3">
                <button class="btn btn-sm btn-outline-secondary py-0"
                        data-bs-toggle="modal" data-bs-target="#modal-<%= $uf->[0] %>">&#9998;</button>
              </td>
            </tr>
            % }
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Redirect URIs (multi-value) -->
  <div class="col-md-6">
    <div class="card">
      <div class="card-header"><strong>Redirect URIs</strong></div>
      <div class="card-body">
        % my @redirect_uris = $entry->get_value('oidcRedirectURI');
        % if (@redirect_uris) {
        <ul class="list-group list-group-flush mb-3">
          % for my $uri (sort @redirect_uris) {
          <li class="list-group-item d-flex justify-content-between align-items-center px-0">
            <code style="font-size:0.8rem"><%= $uri %></code>
            <form method="post" action="/oidc/<%= $clientId %>"
                  data-confirm="Remove this redirect URI?">
              <input type="hidden" name="action" value="redirectURI_remove">
              <input type="hidden" name="value" value="<%= $uri %>">
              <button class="btn btn-outline-danger btn-sm">Remove</button>
            </form>
          </li>
          % }
        </ul>
        % } else {
        <p class="text-muted">No redirect URIs configured.</p>
        % }
        <form method="post" action="/oidc/<%= $clientId %>" class="d-flex gap-2">
          <input type="hidden" name="action" value="redirectURI_add">
          <input type="url" name="value" class="form-control form-control-sm" placeholder="https://..." required>
          <button class="btn btn-primary btn-sm text-nowrap">Add URI</button>
        </form>
      </div>
    </div>
  </div>

  <!-- Scopes (multi-value) -->
  <div class="col-md-6">
    <div class="card">
      <div class="card-header"><strong>Scopes</strong></div>
      <div class="card-body">
        % my @scopes = $entry->get_value('oidcScope');
        % if (@scopes) {
        <div class="mb-3">
          % for my $scope (sort @scopes) {
          <form method="post" action="/oidc/<%= $clientId %>" class="d-inline me-1 mb-1">
            <input type="hidden" name="action" value="scope_remove">
            <input type="hidden" name="value" value="<%= $scope %>">
            <button class="btn btn-sm btn-outline-secondary" title="Click to remove">
              <%= $scope %> &times;
            </button>
          </form>
          % }
        </div>
        % } else {
        <p class="text-muted">No scopes configured.</p>
        % }
        <form method="post" action="/oidc/<%= $clientId %>" class="d-flex gap-2">
          <input type="hidden" name="action" value="scope_add">
          <input type="text" name="value" class="form-control form-control-sm" placeholder="scope name" required>
          <button class="btn btn-primary btn-sm text-nowrap">Add Scope</button>
        </form>
      </div>
    </div>
  </div>

  <!-- Grant Types (multi-value) -->
  <div class="col-md-6">
    <div class="card">
      <div class="card-header"><strong>Grant Types</strong></div>
      <div class="card-body">
        % my @grants = $entry->get_value('oidcGrantType');
        % if (@grants) {
        <div class="mb-3">
          % for my $g (sort @grants) {
          <form method="post" action="/oidc/<%= $clientId %>" class="d-inline me-1 mb-1">
            <input type="hidden" name="action" value="grantType_remove">
            <input type="hidden" name="value" value="<%= $g %>">
            <button class="btn btn-sm btn-outline-secondary" title="Click to remove">
              <%= $g %> &times;
            </button>
          </form>
          % }
        </div>
        % } else {
        <p class="text-muted">No grant types configured.</p>
        % }
        <form method="post" action="/oidc/<%= $clientId %>" class="d-flex gap-2">
          <input type="hidden" name="action" value="grantType_add">
          <select name="value" class="form-select form-select-sm">
            <option value="authorization_code">authorization_code</option>
            <option value="implicit">implicit</option>
            <option value="client_credentials">client_credentials</option>
            <option value="refresh_token">refresh_token</option>
          </select>
          <button class="btn btn-primary btn-sm text-nowrap">Add</button>
        </form>
      </div>
    </div>
  </div>

  <!-- Response Types (multi-value) -->
  <div class="col-md-6">
    <div class="card">
      <div class="card-header"><strong>Response Types</strong></div>
      <div class="card-body">
        % my @rtypes = $entry->get_value('oidcResponseType');
        % if (@rtypes) {
        <div class="mb-3">
          % for my $rt (sort @rtypes) {
          <form method="post" action="/oidc/<%= $clientId %>" class="d-inline me-1 mb-1">
            <input type="hidden" name="action" value="responseType_remove">
            <input type="hidden" name="value" value="<%= $rt %>">
            <button class="btn btn-sm btn-outline-secondary" title="Click to remove">
              <%= $rt %> &times;
            </button>
          </form>
          % }
        </div>
        % } else {
        <p class="text-muted">No response types configured.</p>
        % }
        <form method="post" action="/oidc/<%= $clientId %>" class="d-flex gap-2">
          <input type="hidden" name="action" value="responseType_add">
          <input type="text" name="value" class="form-control form-control-sm"
                 placeholder="e.g. code" required>
          <button class="btn btn-primary btn-sm text-nowrap">Add</button>
        </form>
      </div>
    </div>
  </div>

  <!-- Contacts (multi-value) -->
  <div class="col-md-6">
    <div class="card">
      <div class="card-header"><strong>Contacts</strong></div>
      <div class="card-body">
        % my @contacts = $entry->get_value('oidcContact');
        % if (@contacts) {
        <ul class="list-group list-group-flush mb-3">
          % for my $c (sort @contacts) {
          <li class="list-group-item d-flex justify-content-between align-items-center px-0">
            <%= $c %>
            <form method="post" action="/oidc/<%= $clientId %>">
              <input type="hidden" name="action" value="contact_remove">
              <input type="hidden" name="value" value="<%= $c %>">
              <button class="btn btn-outline-danger btn-sm">Remove</button>
            </form>
          </li>
          % }
        </ul>
        % } else {
        <p class="text-muted">No contacts configured.</p>
        % }
        <form method="post" action="/oidc/<%= $clientId %>" class="d-flex gap-2">
          <input type="hidden" name="action" value="contact_add">
          <input type="email" name="value" class="form-control form-control-sm" placeholder="email" required>
          <button class="btn btn-primary btn-sm text-nowrap">Add</button>
        </form>
      </div>
    </div>
  </div>

  <!-- Post-Logout Redirect URIs (multi-value) -->
  <div class="col-md-6">
    <div class="card">
      <div class="card-header"><strong>Post-Logout Redirect URIs</strong></div>
      <div class="card-body">
        % my @logout_uris = $entry->get_value('oidcPostLogoutRedirectURI');
        % if (@logout_uris) {
        <ul class="list-group list-group-flush mb-3">
          % for my $uri (sort @logout_uris) {
          <li class="list-group-item d-flex justify-content-between align-items-center px-0">
            <code style="font-size:0.8rem"><%= $uri %></code>
            <form method="post" action="/oidc/<%= $clientId %>">
              <input type="hidden" name="action" value="postLogoutRedirectURI_remove">
              <input type="hidden" name="value" value="<%= $uri %>">
              <button class="btn btn-outline-danger btn-sm">Remove</button>
            </form>
          </li>
          % }
        </ul>
        % } else {
        <p class="text-muted">No post-logout redirect URIs.</p>
        % }
        <form method="post" action="/oidc/<%= $clientId %>" class="d-flex gap-2">
          <input type="hidden" name="action" value="postLogoutRedirectURI_add">
          <input type="url" name="value" class="form-control form-control-sm" placeholder="https://..." required>
          <button class="btn btn-primary btn-sm text-nowrap">Add URI</button>
        </form>
      </div>
    </div>
  </div>

</div>

<!-- Danger zone -->
<div class="card border-danger mt-4" style="max-width:400px">
  <div class="card-header text-danger"><strong>Danger Zone</strong></div>
  <div class="card-body">
    <form method="post" action="/oidc/<%= $clientId %>/delete"
          data-confirm="Permanently delete OIDC client <%= $clientId %>?">
      <button class="btn btn-danger">Delete Client</button>
    </form>
  </div>
</div>

<!-- LDAP entry viewer -->
% my %sensitive = map { lc($_) => 1 } qw(oidcClientSecret oidcRegistrationAccessToken);
<div class="modal fade" id="modal-ldap-entry" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-scrollable"><div class="modal-content">
    <div class="modal-header">
      <h5 class="modal-title">LDAP Entry: <%= $clientId %></h5>
      <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>
    <div class="modal-body">
<pre class="mb-0" style="font-size:0.78rem">dn: <%= $entry->dn %>
% for my $attr ($entry->attributes) {
% for my $val ($entry->get_value($attr)) {
% if ($sensitive{lc($attr)}) {
<%= $attr %>: <span class="text-warning fst-italic">&lt;&lt;NOT DISPLAYED&gt;&gt;</span>
% } else {
<%= $attr %>: <%= $val %>
% }
% }
% }
</pre>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
    </div>
  </div></div>
</div>

<!-- Edit modals for single-value text/url fields -->
% for my $mf (@uri_fields) {
<div class="modal fade" id="modal-<%= $mf->[0] %>" tabindex="-1">
  <div class="modal-dialog"><div class="modal-content">
    <form method="post" action="/oidc/<%= $clientId %>">
      <input type="hidden" name="action" value="<%= $mf->[0] %>">
      <div class="modal-header">
        <h5 class="modal-title">Edit <%= $mf->[2] %></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <label class="form-label"><%= $mf->[2] %></label>
        <input type="url" name="value" class="form-control"
               value="<%= $entry->get_value($mf->[1]) // '' %>">
        <div class="form-text">Leave blank to clear.</div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
      </div>
    </form>
  </div></div>
</div>
% }

<!-- Edit Client Name modal -->
<div class="modal fade" id="modal-clientName" tabindex="-1">
  <div class="modal-dialog"><div class="modal-content">
    <form method="post" action="/oidc/<%= $clientId %>">
      <input type="hidden" name="action" value="clientName">
      <div class="modal-header">
        <h5 class="modal-title">Edit Client Name</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <label class="form-label">Client Name</label>
        <input type="text" name="value" class="form-control"
               value="<%= $entry->get_value('oidcClientName') // '' %>">
        <div class="form-text">Leave blank to clear.</div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
      </div>
    </form>
  </div></div>
</div>

<!-- Edit Client Secret modal -->
<div class="modal fade" id="modal-clientSecret" tabindex="-1">
  <div class="modal-dialog"><div class="modal-content">
    <form method="post" action="/oidc/<%= $clientId %>">
      <input type="hidden" name="action" value="clientSecret">
      <div class="modal-header">
        <h5 class="modal-title">Edit Client Secret</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <label class="form-label">Client Secret</label>
        <input type="text" name="value" class="form-control"
               placeholder="Enter new secret or leave blank to remove">
        <div class="form-text">Leave blank to remove (make client public).</div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
      </div>
    </form>
  </div></div>
</div>

<!-- Application Type modal -->
<div class="modal fade" id="modal-applicationType" tabindex="-1">
  <div class="modal-dialog"><div class="modal-content">
    <form method="post" action="/oidc/<%= $clientId %>">
      <input type="hidden" name="action" value="applicationType">
      <div class="modal-header">
        <h5 class="modal-title">Edit Application Type</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <select name="value" class="form-select">
          <option value="web"    <%= ($entry->get_value('oidcApplicationType') // 'web') eq 'web'    ? 'selected' : '' %>>web</option>
          <option value="native" <%= ($entry->get_value('oidcApplicationType') // 'web') eq 'native' ? 'selected' : '' %>>native</option>
        </select>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
      </div>
    </form>
  </div></div>
</div>

<!-- Auth Method modal -->
<div class="modal fade" id="modal-authMethod" tabindex="-1">
  <div class="modal-dialog"><div class="modal-content">
    <form method="post" action="/oidc/<%= $clientId %>">
      <input type="hidden" name="action" value="authMethod">
      <div class="modal-header">
        <h5 class="modal-title">Edit Token Endpoint Auth Method</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        % my $cur_am = $entry->get_value('oidcTokenEndpointAuthMethod') // 'client_secret_basic';
        <select name="value" class="form-select">
          % for my $m (qw(client_secret_basic client_secret_post client_secret_jwt private_key_jwt none)) {
          <option value="<%= $m %>" <%= $cur_am eq $m ? 'selected' : '' %>><%= $m %></option>
          % }
        </select>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
      </div>
    </form>
  </div></div>
</div>

<!-- Subject Type modal -->
<div class="modal fade" id="modal-subjectType" tabindex="-1">
  <div class="modal-dialog"><div class="modal-content">
    <form method="post" action="/oidc/<%= $clientId %>">
      <input type="hidden" name="action" value="subjectType">
      <div class="modal-header">
        <h5 class="modal-title">Edit Subject Type</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        % my $cur_st = $entry->get_value('oidcSubjectType') // 'public';
        <select name="value" class="form-select">
          <option value="public"   <%= $cur_st eq 'public'   ? 'selected' : '' %>>public</option>
          <option value="pairwise" <%= $cur_st eq 'pairwise' ? 'selected' : '' %>>pairwise</option>
        </select>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
      </div>
    </form>
  </div></div>
</div>
