% layout 'default';
% title 'Add Group';

<nav aria-label="breadcrumb" class="mb-3">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/groups">Groups</a></li>
    <li class="breadcrumb-item active">Add</li>
  </ol>
</nav>

<div class="card" style="max-width:400px">
  <div class="card-header"><strong>Add Group</strong></div>
  <div class="card-body">
    <form method="post" action="/groups">
      <%= csrf_field %>
      <div class="mb-3">
        <label class="form-label">Group Name <span class="text-danger">*</span></label>
        <input type="text" name="group" class="form-control" required>
      </div>
      <div class="mb-4">
        <label class="form-label">GID</label>
        <input type="number" name="gid" class="form-control" placeholder="Auto-assigned">
      </div>
      <button class="btn btn-primary">Add Group</button>
      <a href="/groups" class="btn btn-outline-secondary ms-2">Cancel</a>
    </form>
  </div>
</div>
