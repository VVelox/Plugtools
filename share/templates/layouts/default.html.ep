<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> — Plugtools</title>
  <link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
  <style>
    body { padding-top: 56px; font-size: 0.9rem; }
    .navbar-brand { color: #dc3545 !important; font-weight: 700; letter-spacing: 2px; font-size: 1.1rem; }
    .table-sm td, .table-sm th { white-space: nowrap; font-size: 0.82rem; }
    .form-label { font-size: 0.78rem; color: #adb5bd; margin-bottom: 2px; }
  </style>
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top border-bottom border-danger border-opacity-25">
  <div class="container-fluid">
    <a class="navbar-brand" href="/">&#128296; PLUGTOOLS</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
            data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav">
        <li class="nav-item">
          <a class="nav-link<%= $self->req->url->path =~ m{^/users}  ? ' active' : '' %>"
             href="/users">Users</a>
        </li>
        <li class="nav-item">
          <a class="nav-link<%= $self->req->url->path =~ m{^/groups} ? ' active' : '' %>"
             href="/groups">Groups</a>
        </li>
      </ul>
    </div>
  </div>
</nav>

<div class="container-fluid mt-3 px-4">

  % if (my $err = flash('error')) {
  <div class="alert alert-danger alert-dismissible fade show" role="alert">
    <strong>Error:</strong> <%= $err %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
  % }
  % if (my $ok = flash('success')) {
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <%= $ok %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
  % }

  <%= content %>

</div>

<script src="/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>
</html>
