<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> — Plugtools</title>
  <link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
  <style>
    body { background-color: #f8f9fa; }
    .navbar-brand { font-weight: 600; letter-spacing: .05em; }
    .table th { white-space: nowrap; }
    .btn-sm { font-size: .8rem; }
  </style>
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
  <div class="container-fluid">
    <a class="navbar-brand" href="/">&#128296; Plugtools</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
            data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav">
        <li class="nav-item">
          <a class="nav-link<%= $self->req->url->path =~ m{^/users}  ? ' active' : '' %>"
             href="/users">Users</a>
        </li>
        <li class="nav-item">
          <a class="nav-link<%= $self->req->url->path =~ m{^/groups} ? ' active' : '' %>"
             href="/groups">Groups</a>
        </li>
      </ul>
    </div>
  </div>
</nav>

<div class="container-fluid mt-4 px-4">

  % if (my $err = flash('error')) {
  <div class="alert alert-danger alert-dismissible fade show" role="alert">
    <strong>Error:</strong> <%= $err %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
  % }
  % if (my $ok = flash('success')) {
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <%= $ok %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
  % }

  <%= content %>

</div>

<script src="/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>
</html>
