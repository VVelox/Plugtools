% layout 'selfservice';
% title 'Reset Password';
<div class="row justify-content-center mt-5">
  <div class="col-sm-10 col-md-6">
    <div class="card border-secondary">
      <div class="card-header text-danger fw-bold">Reset Password</div>
      <div class="card-body">
        <form method="post" action="<%= url_for('reset_post', token => $token) %>">
          <div class="mb-2">
            <label class="form-label" for="new_pass">New Password</label>
            <input type="password" class="form-control" id="new_pass" name="new_pass"
                   autocomplete="new-password" autofocus required>
          </div>
          <div class="mb-3">
            <label class="form-label" for="confirm">Confirm New Password</label>
            <input type="password" class="form-control" id="confirm" name="confirm"
                   autocomplete="new-password" required>
          </div>
          <button type="submit" class="btn btn-danger w-100">Set New Password</button>
        </form>
      </div>
    </div>
  </div>
</div>
