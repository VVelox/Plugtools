% layout 'selfservice';
% title 'Forgot Password';
<div class="row justify-content-center mt-5">
  <div class="col-sm-10 col-md-6">
    <div class="card border-secondary">
      <div class="card-header text-danger fw-bold">Forgot Password</div>
      <div class="card-body">
        <p class="text-secondary small mb-3">
          Enter your username. If your account has an email address on file,
          we will send you a link to reset your password.
        </p>
        <form method="post" action="<%= url_for('forgot_post') %>">
          <div class="mb-3">
            <label class="form-label" for="user">Username</label>
            <input type="text" class="form-control" id="user" name="user"
                   autocomplete="username" autofocus required>
          </div>
          <button type="submit" class="btn btn-danger w-100">Send Reset Link</button>
        </form>
        <hr class="border-secondary">
        <div class="text-center">
          <a href="<%= url_for('login') %>" class="text-secondary small">Back to login</a>
        </div>
      </div>
    </div>
  </div>
</div>
