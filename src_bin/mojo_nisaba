#!/usr/bin/env perl

use strict;
use warnings;

# Grab --pt-config before Mojolicious sees the argv, then pass the rest through.
use Getopt::Long qw(:config pass_through);
GetOptions( 'pt-config=s' => \( my $pt_config ) );
$ENV{NISABA_CONFIG} = $pt_config if defined $pt_config;

use Mojolicious::Commands;
Mojolicious::Commands->start_app('App::Nisaba::Web');

=head1 NAME

mojo_nisaba - Mojolicious web frontend for App::Nisaba

=head1 SYNOPSIS

  # Development server (port 3000)
  mojo_nisaba daemon

  # Custom port
  mojo_nisaba daemon -l http://*:8080

  # Production (prefork)
  mojo_nisaba prefork -l http://*:8080

  # With a custom nisaba config
  mojo_nisaba daemon --pt-config /etc/nisabarc

=head1 DESCRIPTION

Starts the App::Nisaba web interface. All standard Mojolicious server
commands (daemon, prefork, etc.) are supported after any C<--pt-config>
argument.

=head1 ENVIRONMENT

=head2 NISABA_CONFIG

Path to the nisabarc config file. Overridden by C<--pt-config>.

=head2 NISABA_SECRET

Session secret. Set this to a long random string in production.

=head1 SEE ALSO

L<App::Nisaba>, L<App::Nisaba::Web>

=cut
