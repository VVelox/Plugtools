#!/bin/sh
#
# PROVIDE: mojo_nisaba_selfservice
# REQUIRE: LOGIN NETWORKING
# KEYWORD: shutdown
#
# App::Nisaba self-service web portal, served by Hypnotoad (Mojolicious'
# production preforking server, with zero-downtime hot restarts).
#
# Add the following to /etc/rc.conf (or /etc/rc.conf.d/mojo_nisaba_selfservice)
# to enable and configure this service:
#
#   mojo_nisaba_selfservice_enable="YES"
#   #mojo_nisaba_selfservice_user="www"                       # service user
#   #mojo_nisaba_selfservice_listen="http://*:8081"           # listen URL (NISABA_LISTEN)
#   # ...or serve HTTPS directly (requires IO::Socket::SSL; cert+key readable
#   # by the service user). Quote the whole value because of the "&":
#   #mojo_nisaba_selfservice_listen="https://*:8443?cert=/usr/local/etc/nisaba/tls/server.crt&key=/usr/local/etc/nisaba/tls/server.key"
#   #mojo_nisaba_selfservice_config="/usr/local/etc/nisabarc" # NISABA_CONFIG
#   #mojo_nisaba_selfservice_secret=""                         # NISABA_SECRET (or set websecret in nisabarc)
#   #mojo_nisaba_selfservice_hypnotoad="/usr/local/bin/hypnotoad"
#
# Hypnotoad tuning (leave empty to use Hypnotoad's own defaults):
#   #mojo_nisaba_selfservice_workers="4"             # worker processes
#   #mojo_nisaba_selfservice_clients="1000"          # max concurrent connections per worker
#   #mojo_nisaba_selfservice_accepts="0"             # connections a worker accepts before stopping (0 = unlimited)
#   #mojo_nisaba_selfservice_spare="2"               # spare workers kept warm during a hot restart
#   #mojo_nisaba_selfservice_graceful_timeout="120"  # seconds to let a worker finish before killing it
#   #mojo_nisaba_selfservice_heartbeat_timeout="50"  # seconds before an unresponsive worker is restarted
#   #mojo_nisaba_selfservice_inactivity_timeout="15" # keep-alive connection idle timeout, seconds
#   #mojo_nisaba_selfservice_proxy="1"               # trust reverse-proxy X-Forwarded-* headers
#
# Password-reset email (SMTP) is configured via the nisabarc file.
#
# "service mojo_nisaba_selfservice reload" performs a zero-downtime hot restart
# (e.g. after an upgrade), keeping the listening sockets open across the swap.

. /etc/rc.subr

name="mojo_nisaba_selfservice"
desc="App::Nisaba self-service web portal"
rcvar="${name}_enable"

load_rc_config $name

: ${mojo_nisaba_selfservice_enable:="NO"}
: ${mojo_nisaba_selfservice_user:="www"}
: ${mojo_nisaba_selfservice_group:="${mojo_nisaba_selfservice_user}"}
: ${mojo_nisaba_selfservice_listen:="http://*:8081"}
: ${mojo_nisaba_selfservice_config:="/usr/local/etc/nisabarc"}
: ${mojo_nisaba_selfservice_secret:=""}
: ${mojo_nisaba_selfservice_hypnotoad:="/usr/local/bin/hypnotoad"}
: ${mojo_nisaba_selfservice_workers:=""}
: ${mojo_nisaba_selfservice_clients:=""}
: ${mojo_nisaba_selfservice_accepts:=""}
: ${mojo_nisaba_selfservice_spare:=""}
: ${mojo_nisaba_selfservice_graceful_timeout:=""}
: ${mojo_nisaba_selfservice_heartbeat_timeout:=""}
: ${mojo_nisaba_selfservice_inactivity_timeout:=""}
: ${mojo_nisaba_selfservice_proxy:=""}

# Writable state dir for the brute-force rate-limiter SQLite database
# (rateLimitPath). Only needed while rate limiting is enabled (the default).
: ${mojo_nisaba_selfservice_dbdir:="/var/db/nisaba"}
rundir="/var/run/${name}"

program="/usr/local/bin/${name}"
pidfile="${rundir}/${name}.pid"
# Hypnotoad's own pid file (used for hot-restart coordination); must be writable
# by the service user, so it lives under the run directory rather than next to
# the application script (Hypnotoad's default).
hypnotoad_pidfile="${rundir}/hypnotoad.pid"

# daemon(8) supervises and restarts Hypnotoad. Hypnotoad reads its listen URL
# and all tuning from the environment (exported in the precmd below), so no
# per-URL argument quoting is needed here; "-f" keeps the Hypnotoad manager in
# the foreground so daemon(8) can supervise it.
command="/usr/sbin/daemon"
procname="/usr/sbin/daemon"
command_args="-S -t ${name} -R 5 -P ${pidfile} ${mojo_nisaba_selfservice_hypnotoad} -f ${program}"

start_precmd="${name}_precmd"
extra_commands="reload"
reload_cmd="${name}_reload"

mojo_nisaba_selfservice_setenv()
{
	[ -n "${mojo_nisaba_selfservice_config}" ] && export NISABA_CONFIG="${mojo_nisaba_selfservice_config}"
	[ -n "${mojo_nisaba_selfservice_secret}" ] && export NISABA_SECRET="${mojo_nisaba_selfservice_secret}"
	export NISABA_LISTEN="${mojo_nisaba_selfservice_listen}"
	export NISABA_HYPNOTOAD_PID_FILE="${hypnotoad_pidfile}"
	[ -n "${mojo_nisaba_selfservice_workers}" ]            && export NISABA_HYPNOTOAD_WORKERS="${mojo_nisaba_selfservice_workers}"
	[ -n "${mojo_nisaba_selfservice_clients}" ]            && export NISABA_HYPNOTOAD_CLIENTS="${mojo_nisaba_selfservice_clients}"
	[ -n "${mojo_nisaba_selfservice_accepts}" ]            && export NISABA_HYPNOTOAD_ACCEPTS="${mojo_nisaba_selfservice_accepts}"
	[ -n "${mojo_nisaba_selfservice_spare}" ]              && export NISABA_HYPNOTOAD_SPARE="${mojo_nisaba_selfservice_spare}"
	[ -n "${mojo_nisaba_selfservice_graceful_timeout}" ]   && export NISABA_HYPNOTOAD_GRACEFUL_TIMEOUT="${mojo_nisaba_selfservice_graceful_timeout}"
	[ -n "${mojo_nisaba_selfservice_heartbeat_timeout}" ]  && export NISABA_HYPNOTOAD_HEARTBEAT_TIMEOUT="${mojo_nisaba_selfservice_heartbeat_timeout}"
	[ -n "${mojo_nisaba_selfservice_inactivity_timeout}" ] && export NISABA_HYPNOTOAD_INACTIVITY_TIMEOUT="${mojo_nisaba_selfservice_inactivity_timeout}"
	[ -n "${mojo_nisaba_selfservice_proxy}" ]              && export NISABA_HYPNOTOAD_PROXY="${mojo_nisaba_selfservice_proxy}"
	return 0
}

mojo_nisaba_selfservice_precmd()
{
	# Run directory for the pid files, writable by the service user.
	install -d -o "${mojo_nisaba_selfservice_user}" -g "${mojo_nisaba_selfservice_group}" -m 0755 \
		"${rundir}"

	# State dir for the rate-limiter database, writable by the service user.
	install -d -o "${mojo_nisaba_selfservice_user}" -g "${mojo_nisaba_selfservice_group}" -m 0700 \
		"${mojo_nisaba_selfservice_dbdir}"

	# Pass configuration to the application via the environment (preserved
	# through rc.subr's "su -m").
	mojo_nisaba_selfservice_setenv
	return 0
}

# Zero-downtime hot restart: re-running Hypnotoad against the same application
# upgrades the running manager in place (it locates it via the pid file). "su -m"
# preserves the environment exported above.
mojo_nisaba_selfservice_reload()
{
	mojo_nisaba_selfservice_setenv
	su -m "${mojo_nisaba_selfservice_user}" -c "${mojo_nisaba_selfservice_hypnotoad} ${program}"
}

run_rc_command "$1"
