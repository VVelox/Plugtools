#!/bin/sh
#
# PROVIDE: mojo_nisaba
# REQUIRE: LOGIN NETWORKING
# KEYWORD: shutdown
#
# App::Nisaba LDAP admin web interface.
#
# Add the following to /etc/rc.conf (or /etc/rc.conf.d/mojo_nisaba) to
# enable and configure this service:
#
#   mojo_nisaba_enable="YES"
#   #mojo_nisaba_user="www"                       # service user
#   #mojo_nisaba_listen="http://*:8080"           # Mojolicious listen URL
#   # ...or serve HTTPS directly (requires IO::Socket::SSL; cert+key readable
#   # by the service user). Quote the whole value because of the "&":
#   #mojo_nisaba_listen="https://*:8443?cert=/usr/local/etc/nisaba/tls/server.crt&key=/usr/local/etc/nisaba/tls/server.key"
#   #mojo_nisaba_config="/usr/local/etc/nisabarc" # NISABA_CONFIG
#   #mojo_nisaba_secret=""                         # NISABA_SECRET (or set websecret in nisabarc)
#   #mojo_nisaba_command="prefork"                # Mojolicious server command
#

. /etc/rc.subr

name="mojo_nisaba"
desc="App::Nisaba LDAP admin web interface"
rcvar="${name}_enable"

load_rc_config $name

: ${mojo_nisaba_enable:="NO"}
: ${mojo_nisaba_user:="www"}
: ${mojo_nisaba_group:="${mojo_nisaba_user}"}
: ${mojo_nisaba_listen:="http://*:8080"}
: ${mojo_nisaba_config:="/usr/local/etc/nisabarc"}
: ${mojo_nisaba_secret:=""}
: ${mojo_nisaba_command:="prefork"}
# Writable state dir for the brute-force rate-limiter SQLite database
# (rateLimitPath). Only needed while rate limiting is enabled (the default).
: ${mojo_nisaba_dbdir:="/var/db/nisaba"}

# daemon(8) supervises and restarts the foreground Mojolicious server and
# records its pid; rc.subr runs it as ${mojo_nisaba_user}.
program="/usr/local/bin/${name}"
pidfile="/var/run/${name}/${name}.pid"
command="/usr/sbin/daemon"
procname="/usr/sbin/daemon"
# The listen URL is double-quoted so an HTTPS value such as
# https://*:8443?cert=...&key=... (note the "&") survives rc.subr's eval as a
# single argument instead of being split at the ampersand.
command_args="-S -t ${name} -R 5 -P ${pidfile} ${program} ${mojo_nisaba_command} -l \"${mojo_nisaba_listen}\""

start_precmd="${name}_precmd"

mojo_nisaba_precmd()
{
	# Run directory for the pidfile, writable by the service user.
	install -d -o "${mojo_nisaba_user}" -g "${mojo_nisaba_group}" -m 0755 \
		"/var/run/${name}"

	# State dir for the rate-limiter database, writable by the service user.
	install -d -o "${mojo_nisaba_user}" -g "${mojo_nisaba_group}" -m 0700 \
		"${mojo_nisaba_dbdir}"

	# Pass configuration to the application via the environment (preserved
	# through rc.subr's "su -m").
	[ -n "${mojo_nisaba_config}" ] && export NISABA_CONFIG="${mojo_nisaba_config}"
	[ -n "${mojo_nisaba_secret}" ] && export NISABA_SECRET="${mojo_nisaba_secret}"
	return 0
}

run_rc_command "$1"
